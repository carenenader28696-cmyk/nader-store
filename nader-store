                        <p class="text-2xl font-bold text-red-500 mb-4">$39.99</p>
                        <button class="add-to-cart bg-red-600 hover:bg-red-700 text-white py-2 px-6 rounded" data-product="Nader Bag" data-price="39.99">Add to Cart</button>
                    </div>
                </div>
                <!-- Product 5 -->
                <div class="bg-black rounded-lg shadow-lg overflow-hidden transform hover:scale-105 transition duration-300">
                    <img src="https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/7b2ec866-8bae-491c-9403-5a7156a46f91.png" alt="Front view of a navy blue baseball cap with adjustable strap, 'Nader' stitched in bold white thread on the front panel, curved brim, snapback closure" class="w-full h-48 object-cover onerror" onerror="this.style.display='none';">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-2">Nader Cap</h3>
                        <p class="text-gray-400 mb-4">Comfortable cap for any occasion.</p>
                        <p class="text-2xl font-bold text-red-500 mb-4">$17.99</p>
                        <button class="add-to-cart bg-red-600 hover:bg-red-700 text-white py-2 px-6 rounded" data-product="Nader Cap" data-price="17.99">Add to Cart</button>
