            <p class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto">Discover unique t-shirts, mugs, phone cases, bags, and caps that make a statement. Fulfillment powered by Printify, payments via PayPal.</p>
            <a href="#products" class="bg-red-600 hover:bg-red-700 text-white py-4 px-8 text-lg font-semibold rounded-lg">Shop Now</a>
        </div>
    </section>

    <!-- Products Section -->
    <section id="products" class="py-16 bg-gray-800">
        <div class="container mx-auto px-4">
            <h2 class="text-4xl font-bold hero-text text-center mb-12">Our Products</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Product 1 -->
                <div class="bg-black rounded-lg shadow-lg overflow-hidden transform hover:scale-105 transition duration-300">
                    <img src="https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/7d168bfb-65e3-4c62-9e33-2623b266be15.png" alt="Front view of a sleek black t-shirt featuring bold white text reading 'Nader' on the chest in modern sans-serif font, made from soft cotton fabric, displayed on a model against a urban background" class="w-full h-48 object-cover onerror" onerror="this.style.display='none';">
