                    </div>
                </div>
                <!-- Product 2 -->
                <div class="bg-black rounded-lg shadow-lg overflow-hidden transform hover:scale-105 transition duration-300">
                    <img src="https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/a44fd934-71cd-4be3-9261-cb78843559a6.png" alt="Side view of a white ceramic mug with the word 'Nader' printed in elegant black calligraphy on the side, steam rising from dark coffee inside, placed on a sleek wooden table" class="w-full h-48 object-cover onerror" onerror="this.style.display='none';">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-2">Nader Mug</h3>
                        <p class="text-gray-400 mb-4">Ceramic mug for your favorite drinks.</p>
                        <p class="text-2xl font-bold text-red-500 mb-4">$14.99</p>
                        <button class="add-to-cart bg-red-600 hover:bg-red-700 text-white py-2 px-6 rounded" data-product="Nader Mug" data-price="14.99">Add to Cart</button>
                    </div>
                </div>
                <!-- Product 3 -->
                <div class="bg-black rounded-lg shadow-lg overflow-hidden transform hover:scale-105 transition duration-300">
                    <img src="https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/16ab7afa-aa73-4668-951e-db1e8ce0f269.png" alt="Close-up of a transparent phone case for iPhone with the 'Nader' logo etched in gold metallic ink covering the back, edges raised for protection, with phone inside showing home screen" class="w-full h-48 object-cover onerror" onerror="this.style.display='none';">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-2">Nader Phone Case</h3>
                        <p class="text-gray-400 mb-4">Durable case with elegant design.</p>
                        <p class="text-2xl font-bold text-red-500 mb-4">$19.99</p>
                        <button class="add-to-cart bg-red-600 hover:bg-red-700 text-white py-2 px-6 rounded" data-product="Nader Phone Case" data-price="19.99">Add to Cart</button>
                    </div>
                </div>
                <!-- Product 4 -->
                <div class="bg-black rounded-lg shadow-lg overflow-hidden transform hover:scale-105 transition duration-300">
                    <img src="https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/d5328a55-7e7f-4404-a0fb-e8247cee8c4a.png" alt="Open backpack in black canvas with red 'Nader' embroidery on the front pocket, straps padded, interior lined, standing against a city street backdrop" class="w-full h-48 object-cover onerror" onerror="this.style.display='none';">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-2">Nader Bag</h3>
